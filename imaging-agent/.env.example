# Copy to .env and fill in what this clinic's install needs. Every value here
# is optional — the agent auto-discovers what it can (export folder, bridge
# exe) and only needs overrides for non-standard installs or REST credentials.
# See README.md for the full list and what each one does.

# DENTC_AGENT_PORT=8765
# DENTC_AGENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DENTC_AGENT_TOKEN=

# Vatech EzWebServer REST credentials (a real EzDent-i user account — see
# Settings > Environment > General > USER ACCOUNT MANAGER inside EzDent-i,
# NOT the software's own activation code). Setting both switches the agent
# from folder-watching to polling EzWebServer's REST API directly, which
# never touches the local export folder or its file permissions.
# DENTC_AGENT_VATECH_REST_USERNAME=Master Admin
# DENTC_AGENT_VATECH_REST_PASSWORD=ReckonDental@123

# Only needed for a non-standard Vatech install location/executable path.
# DENTC_AGENT_EXPORT_FOLDER=
# DENTC_AGENT_BRIDGE_EXE=
