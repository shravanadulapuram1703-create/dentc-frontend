# ---------------------------------------------------------------------------
# DentC Frontend — environment variables
# Copy this file to `.env` and adjust per environment. All client-exposed
# vars MUST be prefixed with VITE_ (Vite only exposes VITE_* to the browser).
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend (no trailing slash).
# The WebSocket client derives its ws(s):// URL from this value.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional. Deployment environment label (development | staging | production).
# Used for env-specific behaviour / logging once shared/config/env.ts lands.
VITE_APP_ENV=development
