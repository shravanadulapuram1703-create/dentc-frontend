# ---------------------------------------------------------------------------
# DentC Frontend — environment variables
# Copy this file to `.env` and adjust per environment. All client-exposed
# vars MUST be prefixed with VITE_ (Vite only exposes VITE_* to the browser).
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend (no trailing slash).
# The WebSocket client derives its ws(s):// URL from this value.
VITE_API_BASE_URL=https://dentc-backend-477406612596.us-central1.run.app

# Optional. Deployment environment label (development | staging | production).
# Used for env-specific behaviour / logging once shared/config/env.ts lands.
VITE_APP_ENV=development

# Human-readable app version. Shown in the Help Center and attached to every
# support ticket. Bump per release (or set from your CI build number).
VITE_APP_VERSION=4.3.0

# ---------------------------------------------------------------------------
# Help Center → Jira issue tracking
# ---------------------------------------------------------------------------
# Transport for filing support tickets:
#   auto   (default) — proxy, since the proxy URL now defaults to the backend
#            (below); falls back to direct, then demo.
#   proxy  — POST tickets to YOUR backend, which holds the Jira secret and
#            forwards to Jira. The ONLY browser-safe option for production.
#   direct — call the Jira Cloud REST API from the browser with a token. Dev
#            ONLY: exposes the token to the client and needs Jira CORS config.
#   demo   — no Jira: tickets are stored locally so the flow is demonstrable.
#            NOTE: demo files tickets into localStorage and they never reach
#            Jira, so never ship a production build in this mode.
VITE_JIRA_MODE=auto

# Target Jira project key that tickets are created under. The backend uses the
# key the client sends before its own JIRA_PROJECT_KEY, so this MUST name a real
# project on the configured Jira site or the create fails.
VITE_JIRA_PROJECT_KEY=KAN

# proxy mode: your backend endpoint that forwards to Jira. Optional — defaults to
# $VITE_API_BASE_URL/api/v1/support/tickets. Set only to point somewhere else.
# VITE_JIRA_PROXY_URL=/api/v1/support/tickets

# direct mode (dev only): Atlassian site + API-token Basic auth.
# VITE_JIRA_BASE_URL=https://your-site.atlassian.net
# VITE_JIRA_EMAIL=you@example.com
# VITE_JIRA_API_TOKEN=your-atlassian-api-token

# ---------------------------------------------------------------------------
# AppointNow — external online booking
# ---------------------------------------------------------------------------
# Transport for the public booking screen (/book/:office_code) + staff inbox:
#   local  (default) — client-side simulation (localStorage + BroadcastChannel).
#                      Works end-to-end in a browser with no backend.
#   api    — hit the real /api/v1/appointnow/* endpoints once the backend ships
#            them (see docs/appointnow/appointnow_backend_devreport.md).
VITE_APPOINTNOW_BACKEND=local
