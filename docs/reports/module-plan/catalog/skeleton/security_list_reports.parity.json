   "dynamic_rules": [
    {
     "rule_id": "security_list_reports.r04.d01",
     "legacy_when": "LOCATION = Office Group",
     "legacy_effect": "The SELECT picker chooses office groups defined in Setup > Office Groups (for example regions) instead of offices; when no office groups are defined, a group run covers all offices of the account. This is the OFFICE/GROUP control of the other Lists screens, headed LOCATION on this report - the only Security List report that has it. The vendor documents the behaviour for the Office / Office Group control in general; the report itself is absent from vendor documentation, hence likely.",
     "confidence": "likely",
     "new_behavior": ""
    }
   ],
   "legacy_corrections": [
    {
     "about": "default",
     "control_id": "security_list_reports.r04.s04.c02",
     "text": "The number in the LOCATION box is not a fixed default: with the Office radio the box defaults to the current office (the OID of the session, the same number the title bar shows) and SELECT picks other offices. Stated by the vendor for the Office / Office Group control in general, of which LOCATION is the instance on this report."
    },
    {
     "about": "meaning",
     "control_id": "security_list_reports.r04.s03.c01",
     "text": "What a security group is, i.e. what the Group picker chooses from: security groups are defined per office (the same group name can exist under several offices), and a user has a primary group plus optional additional groups - so one user can appear under several groups. Vendor-documented for security groups; that the picker lists them follows from the name of the criterion."
    }
   ],
